# Copia este archivo como .env y llena los valores reales.
# El archivo .env NUNCA se sube a GitHub.

# Puerto donde escucha la API
PORT=8080

# Conexión a PostgreSQL de Railway (datos de DATABASE_PUBLIC_URL)
DB_URL=jdbc:postgresql://HOST:PUERTO/railway
DB_USER=postgres
DB_PASSWORD=

# Clave para firmar los tokens: mínimo 32 caracteres aleatorios.
# En Railway usen una clave distinta a la de desarrollo.
JWT_SECRET=
#=========== ESTE ES SOLO UN EJEMPLO ================